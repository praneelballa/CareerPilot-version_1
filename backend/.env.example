PROJECT_NAME="CareerPilotAI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"


# LLM Configuration (Groq)
LLM_PROVIDER="groq"
GROQ_API_KEY="your_key"
GROQ_MODEL="openai/gpt-oss-20b"

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL="sqlite:///./careerpilot.db"

# Vector Store Configuration
VECTOR_STORE_PROVIDER="qdrant"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Google OAuth 2.0 Credentials (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/gmail/callback"

# Secret key used to encrypt cached OAuth tokens at rest (Fernet URL-safe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY="___"